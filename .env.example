# Segredo de sessão e assinatura de URLs temporárias de mídia privada
APP_SECRET="toca-da-cria-corte-primaveril-secret-key-2026"

# Provedor de IA (Opcional: "gemini", "openai" ou "local_observational")
# Caso nenhuma chave externa esteja preenchida, o motor observacional local
# processa os registros seguindo as 10 regras obrigatórias sem inventar fatos.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Serviço de Transcrição Local (VoiceStudio Whisper compatível ou OpenAI Whisper)
VOICESTUDIO_API_URL="http://127.0.0.1:3900/v1"

# Supabase (Opcional — o sistema possui persistência local imediata em data/db.json
# e sincroniza com PostgreSQL/Supabase quando configurado)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
